# Web app (web/.env.local). Addresses come from config/devnet.json, so no client variables are needed.
HELIUS_API_KEY=            # Helius RPC key (mainnet reads, devnet orders)
FAUCET_KEYPAIR=            # JSON secret key array: replica mint authority, used by the faucet (not the program upgrade authority)
KEEPER_KEYPAIR=            # JSON secret key array: pays fees for "Check now" fills
KEEPER_TICK_SECRET=        # random string; lets a scheduler run a full keeper pass via /api/keeper/tick

# Keeper worker (npm run keeper)
KEEPER_RPC_URL=            # optional devnet RPC URL; a separate key keeps the keeper off the app's quota
KEEPER_KEYPAIR_PATH=       # optional path to the keeper keypair file
KEEPER_INTERVAL_MS=10000
